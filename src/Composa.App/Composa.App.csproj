<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>composa</AssemblyName>
    <RootNamespace>Composa.App</RootNamespace>
    <ApplicationIcon>../../packaging/icons/composa.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!--
    The words a person reads live in Strings.resx and one file per language beside it; the SDK embeds
    the neutral file and builds a satellite assembly per culture, which dotnet publish copies next to
    the app. Loc.T looks a name up at the moment it is drawn, so the English name stays the identity
    everywhere else. Listing the languages keeps a RID build from carrying satellites nobody asked for.
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>
  <!--
    ImageMagick is bundled everywhere except Linux. Distributions all ship it and the .deb and .rpm
    recommend it, so a Linux download stays 36 MB smaller and redistributes nothing; Windows and macOS
    have no package manager to lean on. A developer build has no RuntimeIdentifier and bundles it, so
    the library is built and tested on every machine even though Linux packages leave it out.
  -->
  <PropertyGroup>
    <BundleImageMagick Condition="'$(BundleImageMagick)' == '' and $(RuntimeIdentifier.StartsWith('linux'))">false</BundleImageMagick>
    <BundleImageMagick Condition="'$(BundleImageMagick)' == ''">true</BundleImageMagick>
    <DefineConstants Condition="'$(BundleImageMagick)' == 'true'">$(DefineConstants);BUNDLED_IMAGEMAGICK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every build carries the bundled film looks, so every build carries the notices that record where they came from. -->
    <None Include="../../packaging/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleImageMagick)' == 'true'">
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.1" GeneratePathProperty="true" />
    <!--
      Bundling redistributes ImageMagick and the LGPL libraries compiled into it, so its notice goes
      wherever the library goes. It is tied to the reference here rather than to a packaging script,
      so no build can carry the library without it.
    -->
    <None Include="$(PkgMagick_NET-Q16-AnyCPU)/Notice.txt" Link="ImageMagick-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleImageMagick)' != 'true'">
    <Compile Remove="BundledImageMagick.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="../Composa.Core/Composa.Core.csproj" />
    <!-- The MCP server that lets an AI agent drive the editor. Core only: the ASP.NET hosting package has no place in a desktop app. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!--
      FileReveal asks the Linux file manager to show a file over D-Bus with the library Avalonia's
      Linux backend already uses, referenced here so an Avalonia upgrade cannot take it away. Keep the
      version the one Avalonia brings: a lower one is a downgrade the restore refuses.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <AvaloniaResource Include="Assets/**" />
    <!--
      How this build was distributed, read back at runtime by UpdateCheck. The packaging scripts
      pass "managed" for the .deb and .rpm, where apt or dnf owns updates and the application must
      not nag about them. Anything else, including a developer build, is "github".
    -->
    <AssemblyMetadata Include="UpdateChannel" Value="$(UpdateChannel)" Condition="'$(UpdateChannel)' != ''" />
    <!--
      Every download is published for one platform and a developer build is not, which is how
      Install.Detect tells a build the releases page can replace from one it cannot.
    -->
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
  </ItemGroup>
  <!--
    SkiaSharp and HarfBuzzSharp ship debug symbols for their native Windows libraries, 105 MB of them,
    and DebugType=none only governs Composa's own. Nobody debugs a native library from a download.
  -->
  <Target Name="LeaveOutDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
