<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="../../src/Composa.App/Composa.App.csproj" />
    <Using Include="Xunit" />
    <!-- The Photoshop file writer is shared with the core tests, so both suites build the same fixtures. -->
    <Compile Include="../Composa.Core.Tests/PsdWriter.cs" Link="PsdWriter.cs" />
  </ItemGroup>
</Project>
